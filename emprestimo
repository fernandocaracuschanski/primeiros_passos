valor_casa=float(input("qual o valor da casa?"))
salario=float(input("qual o salario mensal?"))
anos=float(input("em quantos anos deseja pagar?"))
prestação_mensal=(valor_casa/(anos*12))
limite=(salario*30)/100
if prestação_mensal>limite:
  print("não vai aprovar o crédito")
else:
  print("credito será aprovado")
print(f"o valor da parcela é:{prestação_mensal:.2f}")
print(f"seu limite é:{limite:.2f}")
